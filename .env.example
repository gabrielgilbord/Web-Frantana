# Public
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SHOP_ENABLED=false
# Código de Search Console (opcional): meta verification
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Feature flags
SHOP_ENABLED=false

# Admin auth (local JSON mode). Use a long random secret in production.
ADMIN_EMAIL=admin@frantana.es
ADMIN_PASSWORD=changeme-frantana-admin
ADMIN_SESSION_SECRET=replace-with-32-plus-char-random-secret

# Optional: precomputed scrypt hash (salt:hash). If set, ADMIN_PASSWORD is ignored.
# ADMIN_PASSWORD_HASH=

# Supabase (optional — leave empty to use local JSON store)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Never expose the service role key to the browser.
# SUPABASE_SERVICE_ROLE_KEY=

# Stripe Checkout (required for real payments)
# 1) Create keys in Stripe Dashboard → Developers → API keys
# 2) Set SHOP_ENABLED=true and NEXT_PUBLIC_SHOP_ENABLED=true
# 3) Forward webhooks locally: stripe listen --forward-to localhost:3000/api/webhooks/stripe
# 4) Paste webhook signing secret as STRIPE_WEBHOOK_SECRET
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# SMTP Gmail (auth ≠ remitente visible)
# SMTP_USER autentica; SMTP_FROM_EMAIL es lo que ve el destinatario
# (en Gmail hace falta “Enviar correo como” para esa dirección)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# GMAIL_USER=
# GMAIL_APP_PASSWORD=
SMTP_FROM_NAME=Frantana
SMTP_FROM_EMAIL=frantanaoriginal@gmail.com
SMTP_NOTIFY_TO=frantanaoriginal@gmail.com
CONTACT_NOTIFY_TO=frantanaoriginal@gmail.com

# Optional fallback: Resend (si no hay SMTP)
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=Frantana Web <onboarding@resend.dev>

